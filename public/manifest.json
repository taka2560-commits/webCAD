{
  "name": "Web CAD",
  "short_name": "WebCAD",
  "description": "測量・建設現場向けのブラウザ2D CAD（DXF/DWG対応・オフライン動作）",
  "lang": "ja",
  "id": "/",
  "start_url": ".",
  "scope": "/",
  "display": "standalone",
  "background_color": "#111418",
  "theme_color": "#111418",
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "application/acad": [".dwg"],
        "image/vnd.dxf": [".dxf"],
        "application/x-jww": [".jww"],
        "application/x-sima": [".sim"],
        "application/x-sdr": [".sdr"],
        "application/x-webcad": [".webcad"],
        "text/csv": [".csv"]
      }
    }
  ],
  "launch_handler": { "client_mode": "focus-existing" },
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "file", "accept": ["*/*", ".dwg", ".dxf", ".jww", ".sim", ".sdr", ".webcad", ".csv", ".pdf"] }
      ]
    }
  },
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
